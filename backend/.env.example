# Copie para .env (o .env real nunca vai para o git).

# Client ID OAuth do Google Identity Services (o mesmo VITE_GOOGLE_CLIENT_ID do frontend)
GOOGLE_CLIENT_ID=776335673676-dk7od4ljhh43bio4bppf94i8ou0u9v9i.apps.googleusercontent.com

# Chave do Google AI Studio para o guia por IA (https://aistudio.google.com/)
GEMINI_API_KEY=

# Origens da SPA liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Duração da sessão de visitante, em horas
VISITANTE_TTL_HORAS=2

# Integração com n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=SUA_CHAVE_SECRETA_DO_N8N
N8N_TIMEOUT_SEGUNDOS=5.0

# Chave de autenticação dos endpoints administrativos do ChatOps
SUPPORT_API_KEY=
