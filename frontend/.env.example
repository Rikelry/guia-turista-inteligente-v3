# URL base do backend FastAPI (sem barra final)
VITE_API_BASE_URL=http://localhost:8000

# Client ID do Google Identity Services (opcional: sem ele o login Google fica desabilitado)
VITE_GOOGLE_CLIENT_ID=

# Chave opcional de suporte para consultar métricas operacionais detalhadas (/api/v1/telemetria)
VITE_SUPPORT_API_KEY=
